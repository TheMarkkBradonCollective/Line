# LINE environment. Copy to .env.local (or .dev.vars for wrangler) for local work. Never commit real secrets.
# In Cloudflare, set the server values with `npx wrangler secret put NAME [--env preview]`.
#
# ── Public ───────────────────────────────────────────────────────────────────
# Optional. The site's public address. Falls back to the request's host.
NEXT_PUBLIC_SITE_URL=

# ── Server only (Cloudflare secrets; never prefix with NEXT_PUBLIC_, never commit) ──
# Neon → Connect → pooled connection string (…-pooler…neon.tech/neondb?sslmode=require).
DATABASE_URL=
# 32+ random characters. Signs session cookies and upload tickets. `openssl rand -base64 48`
AUTH_SECRET=
# Optional. Connections per server instance in Node (default 3). Workers always use one per request.
DATABASE_POOL_MAX=

# ── Scripts only (your machine) ───────────────────────────────────────────────
# Neon direct (non-pooled) URI for `npm run db:migrate`, `make-founder`, `db:reset`, `db:import`.
# If unset, scripts use DATABASE_URL.
DIRECT_DATABASE_URL=
# Optional. A Postgres server for `npm run test:core-rule`. Tests always use a throwaway schema.
TEST_DATABASE_URL=

# ── Supabase → Neon import (`npm run db:import`, dry-run unless --write) ───────
# Supabase Postgres URI (read-only user recommended).
SOURCE_DATABASE_URL=
# Supabase Storage REST (with --storage).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=line-media
# Cloudflare R2 API token for bulk media copy (optional; otherwise media_objects in Postgres).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=line-media

# ── Android shell ──────────────────────────────────────────────────────────────
# Point the Capacitor APK at the deployed site, e.g. https://line-preview.<subdomain>.workers.dev
CAPACITOR_SERVER_URL=
