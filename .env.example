# LINE environment. Copy to .env.local for local work. Never commit real secrets.
#
# ── Public (sent to the browser; safe to expose) ───────────────────────────────
# Supabase → Project Settings → API (Data API): Project URL
NEXT_PUBLIC_SUPABASE_URL=https://gswjrpmivgvusynwrpkk.supabase.co
# Supabase → Project Settings → API Keys: Publishable key (sb_publishable_…)
# It has no table access: every LINE table has RLS on with no policies and no grants.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_WW968C4rj3yiyXVCMMH0JQ_IbryksAN
# Optional. The site's public address, used in the sign-up confirmation link.
# On Vercel set it to your production URL (e.g. https://line.vercel.app). Falls back to the request's host.
NEXT_PUBLIC_SITE_URL=

# ── Server only (never prefix with NEXT_PUBLIC_, never commit) ─────────────────
# SERVER ONLY. Supabase → Connect (top bar) → Transaction pooler URI, port 6543, with the database password.
# Used by the app at runtime (Vercel functions): postgres://postgres.<ref>:<password>@aws-…pooler.supabase.com:6543/postgres
DATABASE_URL=
# SERVER ONLY. Supabase → Project Settings → API Keys: Secret key (sb_secret_…).
# Used for private Storage (signed upload/download URLs) and the auth admin API in scripts.
SUPABASE_SECRET_KEY=
# SERVER ONLY, optional. Connections per server instance (default 3).
DATABASE_POOL_MAX=

# ── Scripts only (your machine, not Vercel) ────────────────────────────────────
# SERVER ONLY. Session pooler URI (port 5432) for `npm run db:migrate`, `make-founder`, `db:reset`.
# If unset, scripts use DATABASE_URL.
SUPABASE_DB_URL=
# Optional. A Postgres server for `npm run test:core-rule`. Tests always use a throwaway schema.
# If unset, the test starts its own temporary Postgres (embedded-postgres dev dependency).
TEST_DATABASE_URL=

# ── Android shell ──────────────────────────────────────────────────────────────
# Point the Capacitor APK at the deployed site, e.g. https://line.vercel.app
CAPACITOR_SERVER_URL=
